  "valuation": {
    "method": "Forward EPS x P/E on FY2028 (year ending Jan 2028) non-GAAP diluted EPS (which includes stock-based compensation, per NVIDIA's reporting basis), viewed at the Nov 2027 12-month target date. Q3 FY27 delivered $115.84B revenue (+103% YoY, Data Center $107.6B), 74.9% non-GAAP gross margin, $8.84B non-GAAP opex, and $2.68 non-GAAP EPS on 24.19B diluted shares; Q4 FY27 (14-week) guidance of $130.0B revenue (zero China Data Center compute), 71.0-72.0% gross margin, $10.7B non-GAAP opex, and 17% tax implies ~$2.85 Q4 EPS and ~$9.62 FY27 EPS (~$423.7B revenue). Balance sheet holds $53.5B cash and marketable debt securities vs $32.4B long-term debt, with $227.3B buyback authorization remaining, $518B supply/lease/other commitments, and $118B partner credit guarantees. USD listing, no FX.",
    "bear": 104.0,
    "base": 210.25,
    "bull": 310.5,
    "cases": {
      "bear": {
        "driver": "AI capex digestion or neocloud financing stress stalls FY28 revenue near Q4's 13-week run-rate ($500B, +18% YoY), Rubin/memory costs compress gross margin to 69% ($46B opex, 23.8B shares), and SEC accounting/disclosure scrutiny plus $118B guarantee exposure keep the multiple compressed",
        "assumption": "FY28 EPS $10.40 at 10.0x",
        "target": 104.0
      },
      "base": {
        "driver": "Vera Rubin NVL72 ramp drives FY28 revenue to $640B (+51% YoY, below management's ~75% growth outlook), gross margin stabilizes at 71.5% (Q4 guide midpoint), $48B opex, 17% tax, and buybacks lower diluted shares to 23.5B; Jensen Huang's Nov 22 reinstatement removes CEO-succession risk, but SEC probe and $518B supply/lease commitments cap multiple at 14.5x",
        "assumption": "FY28 EPS $14.50 at 14.5x",
        "target": 210.25
      },
      "bull": {
        "driver": "Rubin ramp tracks near ~72% FY28 revenue growth ($730B), gross margin recovers to 73.0% on maturing yields ($50B opex, 23.3B shares), and an uneventful Q3 10-Q filing plus resolution of the SEC inquiry re-rates shares toward 18x",
        "assumption": "FY28 EPS $17.25 at 18.0x",
        "target": 310.5
      }
    },
    "implied_by_close": "At base FY28 EPS of $14.50, the $165.05 close implies 11.4x. The engine's 5-analyst 12-month-horizon weighted target ($224.00, +35.7% vs +27.4% base) implies 15.4x base EPS, or $15.45 EPS at 14.5x; the broader 56-analyst Yahoo Finance mean ($244.18, +47.9%) implies 16.8x base EPS or $16.84 EPS at 14.5x.",
    "sensitivity": "One turn of P/E moves the base target by $14.50 (8.8 pp of the close); $1.00 of FY28 EPS moves it by $14.50 (8.8 pp).",
    "watch_metric": "Filing of the delayed Q3 FY27 Form 10-Q (risk factors/SEC disclosure), Q4 FY27 gross margin vs 71.0-72.0% guide, and accounts receivable/DSO (64 days in Q3) alongside neocloud credit-guarantee exposure",
    "next_disclosure": "Q3 FY2027 Form 10-Q (expected by Dec 4, 2026) and Q4 FY2027 earnings release (late February 2027)"
