 "valuation": {
  "method": "Bank: book value per ordinary share projected to Nov 2027 x P/B, converted to the NYSE ADR at 1 ADR = 3 ordinary shares (HDFC Bank ADR page) and INR 94.2 per USD (rupee close of about 94.19-94.24 on 2026-11-13, PTI/HDFC Sky reports; not an official rate). Book value: INR 391 per share at Mar 2026 (Value Research/Screener); Sep 2026 not found, estimated about INR 405 (net worth about INR 5.84 trn). Base grows book about 12% to INR 455 by Nov 2027 (RoE 13.5%, RoA 1.78%, low payout; modelled, not guided). Base 2.0x P/B = INR 910 per share = $28.98 per ADR. Cross-check: INR 910 is about 15.7x modelled FY28 EPS of about INR 58 (Q2 FY27 EPS INR 12.7; assumption). Analyst INR targets converted per ADR with the same ratio and FX.",
  "bear": 22.42,
  "base": 28.98,
  "bull": 35.92,
  "cases": {
   "bear": {
    "driver": "NIM compresses further (Q2 about 3.3%, down 10bp QoQ), credit costs rise, RoE near 12%, loan growth lags deposits.",
    "assumption": "Book INR 440 at 1.6x = INR 704 per share, x3/94.2",
    "target": 22.42
   },
   "base": {
    "driver": "Advances grow mid-teens (16.4% YoY in Q2), NIM stabilises around 3.3%, RoA about 1.75%, RoE about 13.5%.",
    "assumption": "Book INR 455 at 2.0x = INR 910 per share, x3/94.2",
    "target": 28.98
   },
   "bull": {
    "driver": "NIM recovers, treasury and fee income rebound, RoE near 15%, re-rating toward its historical premium.",
    "assumption": "Book INR 470 at 2.4x = INR 1,128 per share, x3/94.2",
    "target": 35.92
   }
  },
  "implied_by_close": "The close of $25.83 is about INR 811 per share (25.83 x 94.2 / 3), about 1.8x base Nov 2027 book of INR 455 and about 2.0x estimated Sep 2026 book. The named-analyst mean target of about $31.2 per ADR implies about 2.3x base book, or book of about INR 520 at 2.0x.",
  "sensitivity": "0.1x of P/B moves the base target by $1.45 per ADR (5.6 pp); INR 10 of book per share moves it by $0.32 (1.2 pp).",
  "watch_metric": "NIM (3.3% in Q2 FY27), RoA near 1.75-1.8%, advances growth about 16%, and book value per share growth from about INR 391 at Mar 2026.",
  "next_disclosure": "Q3 FY27 results, expected mid-January 2027 (date not confirmed; check the HDFC Bank investor calendar)."
 },
